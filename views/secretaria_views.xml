<odoo>
    <!-- Vista Tree (Lista) -->
    <record id="view_secretaria_tree" model="ir.ui.view">
        <field name="name">helpdesk.secretary.tree</field>
        <field name="model">helpdesk.secretary</field>
        <field name="arch" type="xml">
            <list string="Secretarías">
                <field name="name"/>
                <field name="team_ids" widget="many2many_tags" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Vista Form -->
    <record id="view_secretaria_form" model="ir.ui.view">
        <field name="name">helpdesk.secretary.form</field>
        <field name="model">helpdesk.secretary</field>
        <field name="arch" type="xml">
            <form string="Secretaría">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="team_ids" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Equipos Asignados">
                            <field name="team_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="active"/>
                                    <field name="company_id" groups="base.group_multi_company"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción de Ventana -->
    <record id="action_helpdesk_secretary" model="ir.actions.act_window">
        <field name="name">Secretarias</field>
        <field name="res_model">helpdesk.secretary</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear una nueva Secretaria
            </p>
        </field>
    </record>
        
    <!-- Menú Item -->
    <menuitem id="menu_helpdesk_secretary_config"
              name="Secretarias"
              parent="helpdesk.helpdesk_menu_config"
              action="action_helpdesk_secretary"
              sequence="10"/>
</odoo>