    <record id="action_consulta_tipo" model="ir.actions.act_window">
        <field name="name">Tipos de Consulta</field>
        <field name="res_model">consulta.tipo</field>
        <field name="view_mode">list,form</field>
        <!--<field name="search_view_id" ref="view_consulta_tipo_search"/>-->
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay tipos de consulta configurados
            </p>
            <p>
                Creá los tipos y subtipos de consulta para clasificar las consultas del bot.
                Podés tener hasta 3 niveles jerárquicos.
            </p>
        </field>
    </record>

    <!-- =======================================================================
         CONSULTA.REGISTRO - VISTAS
         ======================================================================= -->

    <record id="view_consulta_registro_tree" model="ir.ui.view">
        <field name="name">consulta.registro.tree</field>
        <field name="model">consulta.registro</field>
        <field name="arch" type="xml">
            <list string="Consultas" default_order="create_date desc">
                <field name="create_date"/>
                <field name="partner_id"/>
                <field name="full_path_display" string="Tipo de Consulta"/>
                <field name="subject"/>
                <field name="state" widget="badge" 
                       decoration-info="state == 'new'"
                       decoration-warning="state == 'in_progress'"
                       decoration-success="state == 'resolved'"
                       decoration-muted="state == 'archived'"/>
                <field name="tipo_ids" widget="many2many_tags" optional="hide"/>
            </list>
        </field>
    </record>

     <record id="action_consulta_registro" model="ir.actions.act_window">
        <field name="name">Consultas</field>
        <field name="res_model">consulta.registro</field>
        <field name="view_mode">list,form</field>
        <!--<field name="search_view_id" ref="view_consulta_registro_search"/>-->
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay consultas registradas
            </p>
            <p>
                Las consultas se registran automáticamente cuando el bot interactúa con los usuarios.
                Acá podés ver el historial completo y dar seguimiento.
            </p>
        </field>
    </record>

    <record id="view_consulta_registro_form" model="ir.ui.view">
        <field name="name">consulta.registro.form</field>
        <field name="model">consulta.registro</field>
        <field name="arch" type="xml">
            <form string="Registro de Consulta">
                <header>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="new,in_progress,resolved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_consulta_registro)d" type="action" 
                                class="oe_stat_button" icon="fa-list" context="{'search_default_partner_id': partner_id}">
                            <field name="partner_id" widget="statinfo" string="Contacto"/>
                        </button>
                    </div>
                    
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="conversation_id"/>
                            <field name="create_date"/>
                        </group>
                        <group>
                            <field name="tipo_ids" widget="many2many_tags" options="{'color_field': 'id'}"/>
                            <field name="full_path_display" readonly="1" widget="badge"/>
                        </group>
                    </group>
                    
                    <field name="subject" placeholder="Asunto breve..."/>
                    <field name="description" placeholder="Descripción detallada de la consulta..."/>
                    
                    <notebook>
                        <page string="Notas Internas">
                            <field name="notes" placeholder="Notas internas para seguimiento..."/>
                        </page>
                        <page string="Datos de Memoria">
                            <field name="memory_data" widget="json" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

