<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =======================================================================
         CONSULTA.TIPO - VISTAS
         ======================================================================= -->

    <record id="view_consulta_tipo_tree" model="ir.ui.view">
        <field name="name">consulta.tipo.tree</field>
        <field name="model">consulta.tipo</field>
        <field name="arch" type="xml">
            <list string="Tipos de Consulta" default_order="parent_path, sequence">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="parent_id"/>
                <field name="requires_info" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_consulta_tipo_form" model="ir.ui.view">
        <field name="name">consulta.tipo.form</field>
        <field name="model">consulta.tipo</field>
        <field name="arch" type="xml">
            <form string="Tipo de Consulta">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="parent_id"/>
                            <field name="requires_info" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Descripción opcional..."/>

                    <notebook>
                        <page string="Subtipos">
                            <field name="child_ids">
                                <list editable="bottom" default_order="sequence">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="requires_info" widget="boolean_toggle"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
