    <!-- =======================================================================
         MENÚS
         ======================================================================= -->

    <menuitem id="menu_consulta_root"
              name="Consultas WhatsApp"
              parent="helpdesk.helpdesk_menu_config"
              sequence="20"/>

    <menuitem id="menu_consulta_registro"
              name="Historial de Consultas"
              parent="menu_consulta_root"
              action="action_consulta_registro"
              sequence="10"/>

    <menuitem id="menu_consulta_tipo"
              name="Tipos de Consulta"
              parent="menu_consulta_root"
              action="action_consulta_tipo"
              sequence="20"/>

</odoo>